<library path="rover_vda5050_adapter_plugins">
  <class type="rover_vda5050_adapter::plugins::MissionNavThroughNodes"
         base_class_type="adapter::NavThroughNodes">
    <description>Drives a VDA 5050 route through rover_mission_manager (set_mission / run_mission).</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::RoverStateHandler"
         base_class_type="adapter::StateHandler">
    <description>Position, velocity, battery, operating mode, pause, safety and errors of the rover.</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::StartPause" base_class_type="adapter::VDAAction">
    <description>VDA 5050 startPause: stop driving and keep the order.</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::StopPause" base_class_type="adapter::VDAAction">
    <description>VDA 5050 stopPause: continue the order from the first node not yet reached.</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::EnableAuxOutput" base_class_type="adapter::VDAAction">
    <description>enableAuxOutput: switch aux outputs 1..6 (safety PLC DIO00..05) on.</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::DisableAuxOutput" base_class_type="adapter::VDAAction">
    <description>disableAuxOutput: switch aux outputs 1..6 (safety PLC DIO00..05) off.</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::SetDriveMode" base_class_type="adapter::VDAAction">
    <description>setDriveMode: switch the rover to Manual or Automatic (rover_drive_mode set_drive_mode).</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::StartFollowing" base_class_type="adapter::VDAAction">
    <description>startFollowing: start follow-me (rover_follow_me follow_me/start).</description>
  </class>
  <class type="rover_vda5050_adapter::plugins::StopFollowing" base_class_type="adapter::VDAAction">
    <description>stopFollowing: stop follow-me (rover_follow_me follow_me/stop).</description>
  </class>
</library>
